DirectoryIndex index.html
AddDefaultCharset UTF-8
RewriteEngine On

<IfModule mod_headers.c>
	<FilesMatch "\.html$">
		Header set Cache-Control "no-cache, no-store, must-revalidate"
		Header set Pragma "no-cache"
		Header set Expires "0"
	</FilesMatch>
	<FilesMatch "\.(js|css|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2)$">
		Header set Cache-Control "public, max-age=31536000, immutable"
	</FilesMatch>
</IfModule>

# Keep production search signals on the canonical HTTPS apex origin.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^scouty\.ca$ [NC]
RewriteRule ^ https://scouty.ca%{REQUEST_URI} [R=301,L]

# Serve existing files and directories directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Map clean route URLs to Expo's exported .html files.
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# Fall back to the root document for client-side navigation.
RewriteRule ^ index.html [L]
